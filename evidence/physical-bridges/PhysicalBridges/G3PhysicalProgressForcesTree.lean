import PhysicalBridges.G3WitnessedEventExhaustiveness
import PhysicalBridges.G3LivingTreeGenesis

/-!
# G3 backwards summit: physical progress forces the canonical Tree successor

Reuses the existing G3TreeCoverage, G3GenesisContinuationScope and
G3LivingTreeGenesis theorems, without redefining their actual event
relation or any original six-X3 duty.

The existing Tree Genesis theorem requires hRealizes for every stage.
Rather than postulating hRealizes again, this module DERIVES it from:
  (1) progress: every generated state has an independently actual
      physical successor;
  (2) source determinism: every independently actual physical
      successor equals the modeled cultivate successor.

For coverage of the entire independently defined physical event
relation, a third, distinct domain scope is explicitly required:
  (3) every actual physical event begins at a generated Tree state.

This is a backwards elimination of the per-generation hRealizes premise,
NOT a derivation of actual physical progress from the mere existence of
a mathematical next state. No proof of quantum gravity is claimed.
-/

namespace PhysicalBridges.G3PhysicalProgressForcesTree

open PhysicalBridges.G3CompleteKoruEventExhaustiveness
open PhysicalBridges.G3GenesisContinuationScope
open PhysicalBridges.G3LivingTreeGenesis
open PhysicalBridges.G3TreeCoverage
open PhysicalBridges.LivingTreeGenerations
open PhysicalBridges.KoruJokerUniverseTrialFeedback
open PhysicalBridges.KoruObjectiveWholeU
open PhysicalBridges.EverestActualWEventJoin

variable {T H E : Type}

/-- Physical progress restricted to the states actually generated by
    the Tree. Distinct from the modeled fact that cultivate is defined. -/
def GeneratedPhysicalProgress
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop) : Prop :=
  ∀ s, Generated J seed s → ∃ t, physicalStep s t

/-- Independent causal source admissibility: any physical successor
    of a state must be the unique candidate computed by cultivate.
    This does NOT imply that a physical successor exists. -/
def PhysicalSelectsTreeSuccessor
    (J : JokerExperiment T FiniteObjectiveU H)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop) : Prop :=
  ∀ s t, physicalStep s t → t = cultivate J s

/-- The full physical-event scope condition: no externally actual
    event originates outside the generated Tree. This cannot follow
    from the mere fact that the Tree generator runs. -/
def ActualEventsStartGenerated
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop) : Prop :=
  ∀ s t, physicalStep s t → Generated J seed s

/-- Deterministic source admissibility plus real progress forces
    the *specific* next Tree transition to be physically realized.
    No separate per-generation hRealizes certificate is needed. -/
theorem progress_forces_each_tree_transition
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hProgress : GeneratedPhysicalProgress J seed physicalStep)
    (hSelect : PhysicalSelectsTreeSuccessor J physicalStep) :
    ∀ n, physicalStep (grow J seed n) (cultivate J (grow J seed n)) := by
  intro n
  obtain ⟨t, ht⟩ := hProgress (grow J seed n) ⟨n, rfl⟩
  have heq : t = cultivate J (grow J seed n) := hSelect _ _ ht
  simpa only [heq] using ht

/-- Real physical progress and uniqueness of the source successor
    discharge the existing Living Tree Genesis realization gate:
    every later generated state is physically reachable, later than
    the seed, new, and retains the growing ancestral count. -/
theorem physical_progress_yields_living_tree_genesis
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hProgress : GeneratedPhysicalProgress J seed physicalStep)
    (hSelect : PhysicalSelectsTreeSuccessor J physicalStep)
    (n : Nat) :
    PhysicallyActual physicalStep seed (grow J seed (n + 1)) ∧
    (grow J seed (n + 1)).epoch = seed.epoch + (n + 1) ∧
    grow J seed (n + 1) ≠ seed ∧
    (grow J seed (n + 1)).ancestors.length =
      seed.ancestors.length + (n + 1) := by
  exact LIVING_TREE_GENESIS J seed physicalStep
    (progress_forces_each_tree_transition J seed physicalStep
      hProgress hSelect) n

/-- Actual-event domain scope plus canonical successor selection
    discharges the EventExhaustive gate of the previous PR. -/
theorem canonical_selection_and_domain_yield_exhaustiveness
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hSelect : PhysicalSelectsTreeSuccessor J physicalStep)
    (hDomain : ActualEventsStartGenerated J seed physicalStep) :
    EventExhaustive J seed physicalStep := by
  intro s t ht
  obtain ⟨n, hn⟩ := hDomain s t ht
  exact ⟨n, hn, hSelect s t ht⟩

/-- No additional hRealizes or modeled-event inclusion assumptions:
    the existing canonical W event coverage follows from independently
    justified physical source admissibility, physical event domain,
    seed alignment and W-faithful learning. -/
theorem canonical_source_selection_covers_actual_events
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E) (U : FiniteObjectiveU)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hSelect : PhysicalSelectsTreeSuccessor J physicalStep)
    (hDomain : ActualEventsStartGenerated J seed physicalStep)
    (hSeed : seed.whole = objectiveAt U seed.epoch)
    (hFaithful : WFaithful J seed) :
    CompleteWEventCoverage physicalStep (treeStep J seed)
      (fun s => s.whole) (fun s => s.epoch) U := by
  exact tree_source_covers_exhausted_physical_domain
    J seed U physicalStep hSeed hFaithful
    (canonical_selection_and_domain_yield_exhaustiveness
      J seed physicalStep hSelect hDomain)

/-- On generated states, physical progress is *equivalent* to the
    realization of the canonical successor once all actual successors
    are source-admissible. This gives a precise smaller physical gate. -/
theorem generated_progress_iff_realized_canonical
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hSelect : PhysicalSelectsTreeSuccessor J physicalStep) :
    GeneratedPhysicalProgress J seed physicalStep ↔
      (∀ n, physicalStep (grow J seed n)
        (cultivate J (grow J seed n))) := by
  constructor
  · exact progress_forces_each_tree_transition J seed physicalStep
      · hSelect
  · intro h n ⟨k, hk⟩
    subst n
    exact ⟨cultivate J (grow J seed k), h k⟩

#print axioms progress_forces_each_tree_transition
#print axioms physical_progress_yields_living_tree_genesis
#print axioms canonical_selection_and_domain_yield_exhaustiveness
#print axioms canonical_source_selection_covers_actual_events
#print axioms generated_progress_iff_realized_canonical

end PhysicalBridges.G3PhysicalProgressForcesTree

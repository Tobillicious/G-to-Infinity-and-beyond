import PhysicalBridges.G3TreeCoverage
import PhysicalBridges.CompleteKoruMatterspacetimeCoverage
import PhysicalBridges.G3GenesisContinuationScope

/-!
# Backwards summit — exact physical event exhaustiveness

Find before build: the existing COVERAGE_IFF_ALIGNED_AND_W_FAITHFUL
certifies the Living Tree's OWN transitions. It does not show all real
physical events are generated by that Tree.

This module isolates the extra domain-inclusion obligation. It derives
canonical W-coverage for an independently specified physical relation
from (1) aligned Tree source, (2) W-faithful Tree learning, and (3)
evidence that every physical event is a Tree step. Crucially the third
premise is NOT a definition of physical events.

The negative control constructs a physical relation with one external
event, showing the inclusion premise can fail even when the Tree source
is internally well-formed. This does NOT imply that event is harmful,
or that a different complete physical representation cannot cover it.

Nothing in this module establishes actual-world exhaustiveness, 
authentic subject reflection, or all-state nontermination.
-/

namespace PhysicalBridges.G3CompleteKoruEventExhaustiveness

open PhysicalBridges.G3TreeCoverage
open PhysicalBridges.G3GenesisContinuationScope
open PhysicalBridges.LivingTreeGenerations
open PhysicalBridges.KoruJokerUniverseTrialFeedback
open PhysicalBridges.KoruObjectiveWholeU
open PhysicalBridges.EverestActualWEventJoin

variable {T H E : Type}

/-- The physically meaningful inclusion obligation: an independently
defined physicalStep relation contains no transitions outside the
Living Tree's generated transition relation. -/
def EventExhaustive
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop) : Prop :=
  ∀ s t, physicalStep s t → treeStep J seed s t

/-- An independently specified physical domain inherits the existing
positive whole-W coverage theorem if and ONLY IF event exhaustiveness
is *supplied* (along with seed alignment and W-faithful learning).
There is no hypothesis asserting protection or original-six truth. -/
theorem tree_source_covers_exhausted_physical_domain
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E) (U : FiniteObjectiveU)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hSeed : seed.whole = objectiveAt U seed.epoch)
    (hW : WFaithful J seed)
    (hExhaustive : EventExhaustive J seed physicalStep) :
    CompleteWEventCoverage physicalStep (treeStep J seed)
      (fun s => s.whole) (fun s => s.epoch) U := by
  have hTree : CompleteWEventCoverage (treeStep J seed) (treeStep J seed)
      (fun s => s.whole) (fun s => s.epoch) U :=
    (COVERAGE_IFF_ALIGNED_AND_W_FAITHFUL J seed U).mpr ⟨hSeed, hW⟩
  intro s t hPhysical
  exact hTree s t (hExhaustive s t hPhysical)

/-- One real transition outside the generated Tree immediately refutes
Tree exhaustiveness. This is a scope test, NOT automatically a failure
of some larger Complete Koru coverage law. -/
theorem external_physical_event_refutes_tree_exhaustiveness
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (s t : LivingTree T H E)
    (hActual : physicalStep s t)
    (hOutside : ¬ treeStep J seed s t) :
    ¬ EventExhaustive J seed physicalStep := by
  intro h
  exact hOutside (h s t hActual)

/-- A nonvacuous *external physical-event* negative control.
The event relation deliberately admits arbitrary steps in addition
to generated Tree steps. No assertion that arbitrary events are unsafe. -/
def treeOrExternal
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (external : LivingTree T H E → LivingTree T H E → Prop)
    (s t : LivingTree T H E) : Prop :=
  treeStep J seed s t ∨ external s t

/-- If one externally admitted event lies outside the Tree, then even
an internally valid Tree cannot exhaust the expanded physical domain. -/
theorem tree_or_external_event_is_not_exhaustive
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (external : LivingTree T H E → LivingTree T H E → Prop)
    (s t : LivingTree T H E)
    (hExternal : external s t)
    (hOutside : ¬ treeStep J seed s t) :
    ¬ EventExhaustive J seed (treeOrExternal J seed external) := by
  apply external_physical_event_refutes_tree_exhaustiveness
    J seed (treeOrExternal J seed external) s t
  · exact Or.inr hExternal
  · exact hOutside

/-- Event exhaustiveness and all-state exhaustiveness are different
obligations: this is the *event* step; the existing Genesis scope module
handles the *state* successor question. -/
theorem tree_state_exhaustiveness_is_sufficient_for_generated_states
    (J : JokerExperiment T FiniteObjectiveU H)
    (seed : LivingTree T H E)
    (physicalStep : LivingTree T H E → LivingTree T H E → Prop)
    (hRealizes : ∀ n,
      physicalStep (grow J seed n) (cultivate J (grow J seed n)))
    (hStates : ∀ s, Generated J seed s) :
    ∀ s, ∃ t, physicalStep s t :=
  global_physical_nonterminal_if_exhaustive J seed physicalStep hRealizes hStates

#print axioms tree_source_covers_exhausted_physical_domain
#print axioms external_physical_event_refutes_tree_exhaustiveness
#print axioms tree_or_external_event_is_not_exhaustive
#print axioms tree_state_exhaustiveness_is_sufficient_for_generated_states

end PhysicalBridges.G3CompleteKoruEventExhaustiveness
